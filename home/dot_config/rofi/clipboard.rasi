/* Import Matugen colors */
@import "colors.rasi"

* {
    background-color: transparent;
    font: "MapleMono 12";
}

window {
    width: 600px;
    transparency: "real";
    background-color: var(surface);
    border-radius: 16px;
    padding: 20px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 15px;
}

inputbar {
    background-color: var(surface-container-low);
    border-radius: 16px;
    padding: 12px 16px;
    children: [ entry ];
}

prompt {
    text-color: var(primary-fixed-dim);
}

entry {
    font: "MapleMono Bold Italic 12";
    placeholder: " Search Clipboard...";
    text-color: var(on-surface-variant);
}

listview {
    columns: 1;
    lines: 7;
    spacing: 7px;
}

element {
    padding: 12px 16px;
    border-radius: 16px;
    cursor: pointer;
    children: [ element-icon, element-text ];
    spacing: 12px;
    background-color: var(surface-container-low);
    text-color: var(on-surface-variant);
}

element-icon {
    size: 48px;
    background-color: transparent;
}

element selected.normal {
    /* The subtle pill highlight from your screenshot */
    background-color: var(primary);
    text-color: var(on-primary);
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
    cursor: inherit;
}
